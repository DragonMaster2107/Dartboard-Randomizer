@page "/"
@inject NavigationManager Nav
@inject GameController Game
@inject GameStorage Storage
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">New Game</MudText>

    @if (Game.HasActiveGame)
    {
        <MudPaper Class="pa-3 mb-4 d-flex justify-space-between align-center" Outlined="true">
            <MudText Typo="Typo.body2">A game is in progress.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="Resume">
                Resume
            </MudButton>
        </MudPaper>
    }

    @* ---------------- Game mode ---------------- *@
    @* Kompakte Zeile statt Karten-Galerie: die Auswahl steckt im Dialog, damit die
       Setup-Seite auch bei vielen Modi ein Screen bleibt. *@
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            @* min-width:0 inline, damit die Tagline umbricht statt den Change-Button
               hinauszuschieben — als Komponente bekommt MudStack kein Scope-Attribut. *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Style="min-width:0">
                <MudIcon Icon="@Mode.Icon" Size="Size.Large" Color="Color.Primary" />
                <div class="mode-summary-text">
                    <MudText Typo="Typo.h6">@Mode.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Mode.Tagline</MudText>
                </div>
            </MudStack>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       EndIcon="@Icons.Material.Filled.ChevronRight"
                       OnClick="@(() => _modePickerOpen = true)">
                Change
            </MudButton>
        </MudStack>
    </MudPaper>

    @* ---------------- Players ---------------- *@
    <MudPaper Class="pa-6 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Players</MudText>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTextField @bind-Value="_newPlayerName"
                          Immediate="true"
                          Label="Player name"
                          Variant="Variant.Outlined"
                          OnKeyDown="OnNameKeyDown"
                          Class="flex-grow-1" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddPlayer"
                       Disabled="@(!CanAddPlayer)">
                Add
            </MudButton>
        </MudStack>

        @if (_players.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No players added yet.</MudText>
        }
        else
        {
            @* Drag & drop reordering (desktop) — the arrow buttons do the same on touch. *@
            <MudDropContainer T="string" @ref="_dropContainer" Items="_players"
                              ItemsSelector="@((item, zone) => true)"
                              ItemDropped="OnPlayerDropped">
                <ChildContent>
                    <MudDropZone T="string" AllowReorder="true" />
                </ChildContent>
                <ItemRenderer>
                    <MudPaper Class="pa-2 pl-2 mb-2 player-row" Elevation="0" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                         Size="Size.Small" Class="drag-handle" />
                                <MudAvatar Size="Size.Small" Color="Color.Primary">@(_players.IndexOf(context) + 1)</MudAvatar>
                                <MudText>@context</MudText>
                            </MudStack>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => RemovePlayer(context))" />
                        </MudStack>
                    </MudPaper>
                </ItemRenderer>
            </MudDropContainer>
        }

        @if (_players.Count > 1)
        {
            <MudSwitch @bind-Value="_randomOrder" Color="Color.Primary" Class="mt-2"
                       Label="Randomize play order" />
            @if (_randomOrder)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-14">
                    Turn this off to keep the order above.
                </MudText>
            }
        }
    </MudPaper>

    @* ---------------- Mode settings (X01) ---------------- *@
    @* Bleibt bewusst ein eigenes, immer sichtbares Panel — nur Modi-spezifisch, also
       an den Modus gekoppelt. Weitere Modi bringen hier ihr eigenes Panel mit. *@
    @if (_mode == GameMode.X01)
    {
    <MudPaper Class="pa-6 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">@Mode.Name settings</MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Starting score</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
            <MudButton Variant="@PresetVariant(101)" Color="Color.Primary" OnClick="@(() => _startScore = 101)">101</MudButton>
            <MudButton Variant="@PresetVariant(301)" Color="Color.Primary" OnClick="@(() => _startScore = 301)">301</MudButton>
            <MudButton Variant="@PresetVariant(501)" Color="Color.Primary" OnClick="@(() => _startScore = 501)">501</MudButton>
            <MudNumericField @bind-Value="_startScore" Label="Custom" Variant="Variant.Outlined" Min="2" Style="max-width:130px;" />
        </MudStack>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Checkout</MudText>
        <MudToggleGroup T="OutMode" @bind-Value="_outMode" Color="Color.Primary">
            <MudToggleItem Value="OutMode.Straight" Text="Straight" />
            <MudToggleItem Value="OutMode.Double" Text="Double" />
            <MudToggleItem Value="OutMode.Master" Text="Master" />
        </MudToggleGroup>
    </MudPaper>
    }

    @* ---------------- Board modifiers ---------------- *@
    @* Zweite Achse neben dem Modus: gelten für JEDEN Modus, der sie unterstützt.
       Zugeklappt, weil sie selten geändert werden — der Badge zeigt trotzdem, dass
       welche aktiv sind. *@
    @if (Mode.SupportsBoardModifiers)
    {
        <MudExpansionPanels Class="mb-4" Elevation="2">
            <MudExpansionPanel @bind-Expanded="_modifiersExpanded">
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Shuffle" Size="Size.Small" />
                        <MudText Typo="Typo.h6">Modifiers</MudText>
                        @if (ActiveModifierCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                     Variant="Variant.Filled" Class="ml-1">
                                @ActiveModifierCount active
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">None</MudText>
                        }
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudSwitch @bind-Value="Randomize" Color="Color.Primary" Label="Randomize board" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4 ml-14">
                        Shuffle all field values across the board for the whole game.
                    </MudText>

                    <MudSwitch @bind-Value="Hidden" Color="Color.Primary" Label="Hidden values" Disabled="@(!_randomize)" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4 ml-14">
                        Field values stay hidden until you hit them. Requires Randomize.
                    </MudText>

                    <MudSwitch @bind-Value="_revealNoScore" Color="Color.Primary" Label="First hit only reveals" Disabled="@(!_hiddenValues)" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-14">
                        The revealing dart scores 0 — only hits on already-revealed fields count. Requires Hidden values.
                    </MudText>

                    @if (_randomize)
                    {
                        <MudTextField @bind-Value="_seed"
                                      Label="Seed (optional)"
                                      Variant="Variant.Outlined"
                                      Class="mt-4"
                                      HelperText="Same seed = same shuffled board. Leave empty for a random one." />
                    }
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    @* Klebt beim Scrollen am unteren Rand — die Seite wächst mit jedem neuen Modus,
       der Start-Button darf dabei nicht wegwandern. *@
    <div class="start-bar">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   Disabled="@(!CanStart)"
                   OnClick="StartGame">
            Start game
        </MudButton>
        @if (!CanStart)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="d-block mt-1">
                @(Mode.MinPlayers == 1
                    ? "Add at least one player."
                    : $"{Mode.Name} needs at least {Mode.MinPlayers} players.")
            </MudText>
        }
    </div>
</MudContainer>

<GameModePicker @bind-Visible="_modePickerOpen" Value="_mode" ValueChanged="OnModeChanged" />

@code {
    protected override void OnInitialized() => Game.Changed += OnGameChanged;
    public void Dispose() => Game.Changed -= OnGameChanged;
    private void OnGameChanged() => InvokeAsync(StateHasChanged);
    private void Resume() => Nav.NavigateTo("game");

    // Spieler und Optionen des letzten Spiels vorbefüllen
    // (nach dem ersten Render, da JS-Interop nötig).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _prefilled)
            return;

        _prefilled = true;

        var last = await Storage.LoadLastPlayersAsync();
        if (last.Count > 0 && _players.Count == 0)
        {
            _players.AddRange(last);
            _dropContainer?.Refresh();
        }

        var setup = await Storage.LoadLastSetupAsync();
        if (setup is not null)
        {
            _startScore = setup.StartingScore;
            _outMode = setup.OutMode;
            // Direkt auf die Felder, nicht über die Properties: deren Kopplungslogik
            // (Randomize aus -> Hidden aus) würde die Reihenfolge hier stören.
            _randomize = setup.Randomize;
            _hiddenValues = setup.HiddenValues;
            _revealNoScore = setup.RevealDoesNotScore;
            _randomOrder = setup.RandomOrder;
            _mode = setup.Mode;
        }

        StateHasChanged();
    }

    /// <summary>Die Definition des gewählten Modus — treibt Kopfzeile, Panels und Start-Button.</summary>
    private GameModeDefinition Mode => GameModes.Get(_mode);

    private bool CanStart => _players.Count >= Mode.MinPlayers;

    private int ActiveModifierCount =>
        (_randomize ? 1 : 0) + (_hiddenValues ? 1 : 0) + (_revealNoScore ? 1 : 0);

    private bool _prefilled;
    private bool _modePickerOpen;
    private bool _modifiersExpanded;
    private GameMode _mode = SetupDefaults.Initial.Mode;
    private readonly List<string> _players = new();
    private string _newPlayerName = "";
    private int _startScore = SetupDefaults.Initial.StartingScore;
    private OutMode _outMode = SetupDefaults.Initial.OutMode;
    private bool _randomize = SetupDefaults.Initial.Randomize;
    private bool _hiddenValues = SetupDefaults.Initial.HiddenValues;
    private bool _revealNoScore = SetupDefaults.Initial.RevealDoesNotScore;
    private bool _randomOrder = SetupDefaults.Initial.RandomOrder;
    private string _seed = "";

    private bool CanAddPlayer => !string.IsNullOrWhiteSpace(_newPlayerName);

    // Modus gewechselt: Modifikatoren abschalten, wenn der neue Modus sie nicht trägt —
    // sonst würde ein unsichtbares Flag ins Spiel wandern.
    private void OnModeChanged(GameMode mode)
    {
        _mode = mode;
        if (!GameModes.Get(mode).SupportsBoardModifiers)
            Randomize = false;
    }

    // Hidden values only make sense on a randomized board, so switch it off with Randomize.
    private bool Randomize
    {
        get => _randomize;
        set
        {
            _randomize = value;
            if (!value)
            {
                _hiddenValues = false;
                _revealNoScore = false;
                _seed = "";
            }
        }
    }

    // "First hit only reveals" depends on Hidden, so switch it off with Hidden.
    private bool Hidden
    {
        get => _hiddenValues;
        set
        {
            _hiddenValues = value;
            if (!value)
                _revealNoScore = false;
        }
    }

    private void AddPlayer()
    {
        var name = _newPlayerName.Trim();
        if (name.Length == 0)
            return;

        // ignore duplicates (case-insensitive)
        if (!_players.Any(p => string.Equals(p, name, StringComparison.OrdinalIgnoreCase)))
            _players.Add(name);

        _newPlayerName = "";
        _dropContainer?.Refresh();
    }

    // ---------- Reihenfolge ändern (Drag & Drop bzw. Pfeil-Buttons) ----------

    private MudDropContainer<string>? _dropContainer;

    private void OnPlayerDropped(MudItemDropInfo<string> info)
    {
        var oldIndex = _players.IndexOf(info.Item!);
        if (oldIndex < 0)
            return;

        var newIndex = Math.Clamp(info.IndexInZone, 0, _players.Count - 1);
        if (newIndex == oldIndex)
            return;

        _players.RemoveAt(oldIndex);
        _players.Insert(newIndex, info.Item!);
        _dropContainer?.Refresh();
    }

    // Fisher-Yates
    private static void Shuffle(IList<string> list)
    {
        for (var i = list.Count - 1; i > 0; i--)
        {
            var j = Random.Shared.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
    }

    private void RemovePlayer(string name)
    {
        _players.Remove(name);
        _dropContainer?.Refresh();
    }

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            AddPlayer();
    }

    private Variant PresetVariant(int value)
        => _startScore == value ? Variant.Filled : Variant.Outlined;

    private async Task StartGame()
    {
        int? seed = null;
        if (_randomize)
            seed = int.TryParse(_seed, out var parsed) ? parsed : Random.Shared.Next();

        // Eingegebene Reihenfolge fürs nächste Setup merken (stabil für den Nutzer).
        await Storage.SaveLastPlayersAsync(_players.ToList());

        // Optionen fürs nächste Setup merken (ohne Seed — der wird pro Spiel neu erzeugt).
        await Storage.SaveLastSetupAsync(new SetupDefaults(
            StartingScore: _startScore,
            OutMode: _outMode,
            Randomize: _randomize,
            HiddenValues: _hiddenValues,
            RevealDoesNotScore: _revealNoScore,
            RandomOrder: _randomOrder,
            Mode: _mode));

        // Startreihenfolge zufällig mischen (falls aktiviert).
        var order = _players.ToList();
        if (_randomOrder)
            Shuffle(order);

        var settings = new GameSettings(
            PlayerNames: order,
            StartingScore: _startScore,
            OutMode: _outMode,
            Randomize: _randomize,
            HiddenValues: _hiddenValues,
            Seed: seed)
        {
            Mode = _mode,
            RevealDoesNotScore = _revealNoScore,
        };

        Game.StartGame(settings);
        Nav.NavigateTo("game");
    }
}
