@page "/game"
@inject GameController Game
@inject NavigationManager Nav
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @if (Game.Current is null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            No active game yet. Start one from the setup screen.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Settings"
                   OnClick="@(() => Nav.NavigateTo("/"))">
            Go to setup
        </MudButton>
    }
    else
    {
        var g = Game.Current;

        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h4">Game</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Undo"
                           Disabled="@(!Game.CanUndo)" OnClick="Undo">
                    Undo
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="EndAndShowStats">
                    End
                </MudButton>
            </MudStack>
        </MudStack>

        <MudStack Row="true" Spacing="2" Class="mb-4" Wrap="Wrap.Wrap">
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Flag">
                @g.StartingScore
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                @($"{g.OutMode} out")
            </MudChip>
            @if (g.Randomize)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Shuffle">
                    Randomized
                </MudChip>
            }
            @if (g.HiddenValues)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.VisibilityOff">
                    Hidden
                </MudChip>
            }
            @if (g.Seed is int seed)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Tag">
                    Seed @seed
                </MudChip>
            }
        </MudStack>

        <MudPaper Class="pa-3 mb-4" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">This turn</MudText>
                @for (var d = 0; d < 3; d++)
                {
                    if (d < g.CurrentTurn.Count)
                    {
                        var dart = g.CurrentTurn[d];
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@dart.ShortLabel · @dart.Points</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">–</MudChip>
                    }
                }
            </MudStack>
        </MudPaper>

        <MudStack Spacing="2" Class="mb-6">
            @for (var i = 0; i < g.Players.Count; i++)
            {
                var player = g.Players[i];
                var isCurrent = i == g.CurrentPlayerIndex && g.AcceptsThrows;
                var number = i + 1;
                <MudPaper Class="pa-4" Elevation="@(isCurrent ? 6 : 1)" Outlined="@(!isCurrent)"
                          Style="@(isCurrent ? "border-left: 4px solid var(--mud-palette-primary);" : "")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudAvatar Color="@(isCurrent ? Color.Primary : Color.Surface)" Size="Size.Small">
                                @number
                            </MudAvatar>
                            <MudText Typo="Typo.h6">@player.Name</MudText>
                            @if (player.HasFinished)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                         Icon="@Icons.Material.Filled.EmojiEvents">
                                    #@player.FinishRank
                                </MudChip>
                            }
                            else if (isCurrent)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                                    to throw
                                </MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.h4">@player.Score</MudText>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
        </MudContainer>

        @if (g.AcceptsThrows && g.Randomize && _layout is not null)
        {
            <DartBoard Layout="_layout" Hidden="g.HiddenValues" Revealed="g.RevealedPositions" OnHit="HandleBoardHit" />
            <div class="d-flex justify-center mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.RemoveCircleOutline"
                           OnClick="@(() => Game.RecordThrow(FieldValue.Miss))">
                    Miss (0)
                </MudButton>
            </div>
        }
        else if (g.AcceptsThrows)
        {
            <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
                <Numpad OnDart="HandleDart" />
            </MudContainer>
        }

        <MudDialog Visible="g.AwaitingContinueDecision" Options="_dialogOptions">
            <TitleContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Success" Class="mr-2" />
                    @g.CurrentPlayer.Name finished!
                </MudText>
            </TitleContent>
            <DialogContent>
                <MudText>Play the game out with the remaining players?</MudText>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="EndAndShowStats">No, end &amp; show stats</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Continue">Yes, play on</MudButton>
            </DialogActions>
        </MudDialog>
    }
</MudContainer>

@code {
    private BoardLayout? _layout;
    private readonly DialogOptions _dialogOptions = new() { BackdropClick = false, CloseOnEscapeKey = false };

    protected override void OnInitialized()
    {
        Game.Changed += OnGameChanged;
        RebuildLayout();
    }

    public void Dispose() => Game.Changed -= OnGameChanged;

    private void OnGameChanged()
    {
        if (Game.Current?.IsOver == true)
        {
            Nav.NavigateTo("/stats");
            return;
        }

        RebuildLayout();
        InvokeAsync(StateHasChanged);
    }

    private void RebuildLayout()
        => _layout = Game.Current is { Randomize: true, Seed: int seed }
            ? BoardLayout.Shuffled(seed)
            : null;

    // Board hit: look up the (shuffled) value for the hit position and reveal it.
    private void HandleBoardHit(BoardPosition pos) => Game.RecordThrow(_layout!.ValueAt(pos), pos);

    // Numpad: a plain dart, no board position to reveal.
    private void HandleDart(FieldValue value) => Game.RecordThrow(value);

    private void Undo() => Game.Undo();

    private void Continue() => Game.ContinuePlaying();

    private void EndAndShowStats() => Game.EndNow(); // OnGameChanged navigates to /stats
}
