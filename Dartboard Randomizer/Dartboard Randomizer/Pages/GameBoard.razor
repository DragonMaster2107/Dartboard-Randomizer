@page "/game"
@inject GameController Game
@inject NavigationManager Nav
@inject AppSettings Settings
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @if (Game.Current is null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            No active game yet. Start one from the setup screen.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Settings"
                   OnClick="@(() => Nav.NavigateTo(""))">
            Go to setup
        </MudButton>
    }
    else
    {
        var g = Game.Current;

        @if (Settings.ShowTurnBanner && g.AcceptsThrows)
        {
            var bannerCheckout = _checkout;
            <div class="turn-banner">
                <span class="tb-player">@g.CurrentPlayer.Name</span>
                <span class="tb-score">@g.CurrentPlayer.Score</span>
                <span class="tb-darts">
                    @for (var d = 0; d < 3; d++)
                    {
                        <span class="tb-dart">@(d < g.CurrentTurn.Count ? g.CurrentTurn[d].ShortLabel : "–")</span>
                    }
                </span>
                @if (bannerCheckout is not null)
                {
                    <span class="tb-checkout">🎯 @string.Join(" ", bannerCheckout.Select(v => v.ShortLabel))</span>
                }
            </div>
            <div class="banner-spacer"></div>
        }

        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h4">Game</MudText>
            <MudStack Row="true" Spacing="2">
                @if (g.HiddenValues && g.AcceptsThrows)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="@(() => _confirmReveal = true)">
                        Reveal
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Close"
                           OnClick="@(() => _confirmEnd = true)">
                    End
                </MudButton>
            </MudStack>
        </MudStack>

        <MudStack Row="true" Spacing="2" Class="mb-4" Wrap="Wrap.Wrap">
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Flag">
                @g.StartingScore
            </MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                @($"{g.OutMode} out")
            </MudChip>
            @if (g.Randomize)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Shuffle">
                    Randomized
                </MudChip>
            }
            @if (g.HiddenValues)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.VisibilityOff">
                    Hidden
                </MudChip>
            }
            @if (g.Conquest)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Flag">
                    Conquest
                </MudChip>
            }
            @if (g.Sabotage)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.TrendingUp">
                    Sabotage
                </MudChip>
            }
            @if (g.Seed is int seed)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Tag">
                    Seed @seed
                </MudChip>
            }
        </MudStack>

        <MudPaper Class="pa-3 mb-4" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">This turn</MudText>
                @for (var d = 0; d < 3; d++)
                {
                    if (d < g.CurrentTurn.Count)
                    {
                        var dart = g.CurrentTurn[d];
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@dart.ShortLabel · @dart.Points</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">–</MudChip>
                    }
                }
            </MudStack>
            @{
                var checkout = _checkout;
            }
            @if (checkout is not null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                    <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Color="Color.Success" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Color="Color.Success">Checkout:</MudText>
                    @foreach (var v in checkout)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">@v.ShortLabel</MudChip>
                    }
                </MudStack>
            }
        </MudPaper>

        <MudStack Spacing="2" Class="mb-6">
            @for (var i = 0; i < g.Players.Count; i++)
            {
                var player = g.Players[i];
                var isCurrent = i == g.CurrentPlayerIndex && g.AcceptsThrows;
                var number = i + 1;
                <MudPaper Class="pa-4" Elevation="@(isCurrent ? 6 : 1)" Outlined="@(!isCurrent)"
                          Style="@(isCurrent ? "border-left: 4px solid var(--mud-palette-primary);" : "")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudAvatar Color="@(isCurrent ? Color.Primary : Color.Surface)" Size="Size.Small">
                                @number
                            </MudAvatar>
                            <MudText Typo="Typo.h6">@player.Name</MudText>
                            @if (player.HasFinished)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                         Icon="@Icons.Material.Filled.EmojiEvents">
                                    #@player.FinishRank
                                </MudChip>
                            }
                            else if (isCurrent)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                                    to throw
                                </MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.h4">@player.Score</MudText>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
        </MudContainer>

        @if (g.AcceptsThrows && g.Randomize && _layout is not null)
        {
            <DartBoard Layout="_layout" Hidden="g.HiddenValues" Revealed="g.RevealedPositions"
                       Targets="VisibleCheckoutTargets" Foreign="_foreignFields"
                       OnHit="HandleBoardHit" />
            <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Undo"
                           Disabled="@(!Game.CanUndo)" OnClick="Undo">
                    Undo
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.RemoveCircleOutline"
                           OnClick="@(() => Game.RecordThrow(FieldValue.Miss))">
                    Miss (0)
                </MudButton>
            </MudStack>
        }
        else if (g.AcceptsThrows)
        {
            <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
                <Numpad OnDart="HandleDart" />
                <MudStack Row="true" Justify="Justify.Center" Class="mt-3">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Undo"
                               Disabled="@(!Game.CanUndo)" OnClick="Undo">
                        Undo
                    </MudButton>
                </MudStack>
            </MudContainer>
        }

        <MudDialog @bind-Visible="_confirmReveal">
            <TitleContent>
                <MudText Typo="Typo.h6">Reveal the whole board?</MudText>
            </TitleContent>
            <DialogContent>
                <MudText>This uncovers all field values for the rest of the game.</MudText>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _confirmReveal = false)">Cancel</MudButton>
                <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="ConfirmReveal">Reveal</MudButton>
            </DialogActions>
        </MudDialog>

        <MudDialog @bind-Visible="_confirmEnd">
            <TitleContent>
                <MudText Typo="Typo.h6">End game?</MudText>
            </TitleContent>
            <DialogContent>
                <MudText>End the game now and show the statistics?</MudText>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _confirmEnd = false)">Cancel</MudButton>
                <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmEnd">End game</MudButton>
            </DialogActions>
        </MudDialog>

        <MudDialog Visible="g.AwaitingContinueDecision" Options="_dialogOptions">
            <TitleContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Success" Class="mr-2" />
                    @FinisherName(g) finished!
                </MudText>
            </TitleContent>
            <DialogContent>
                <MudText>Play the game out with the remaining players?</MudText>
                @* Im Conquest-Modus kann ein Spieler durch den Wurf eines anderen fertig
                   werden — dann läuft dessen Runde nach "Yes" normal weiter. *@
                @if (g.PendingFinisherIndex is int fin && fin != g.CurrentPlayerIndex)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        @g.CurrentPlayer.Name hit a conquered field and finishes the turn
                        (@(3 - g.CurrentTurn.Count) darts left).
                    </MudText>
                }
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="EndAndShowStats">No, end &amp; show stats</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Continue">Yes, play on</MudButton>
            </DialogActions>
        </MudDialog>
    }
</MudContainer>

@code {
    private BoardLayout? _layout;
    private bool _confirmEnd;
    private bool _confirmReveal;
    private readonly DialogOptions _dialogOptions = new() { BackdropClick = false, CloseOnEscapeKey = false };

    protected override void OnInitialized()
    {
        Game.Changed += OnGameChanged;
        Settings.Changed += OnSettingsChanged;
        RebuildLayout();
        RecomputeCheckout();
    }

    public void Dispose()
    {
        Game.Changed -= OnGameChanged;
        Settings.Changed -= OnSettingsChanged;
    }

    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);

    private void OnGameChanged()
    {
        if (Game.Current?.IsOver == true)
        {
            Nav.NavigateTo("stats");
            return;
        }

        RebuildLayout();
        RecomputeCheckout();
        InvokeAsync(StateHasChanged);
    }

    private void RebuildLayout()
        => _layout = Game.Current is { Randomize: true, Seed: int seed }
            ? BoardLayout.Shuffled(seed)
            : null;

    // Bester Checkout aus den verfügbaren Wertigkeiten (Hidden: nur aufgedeckte), oder null.
    // Hängt nur am Spielzustand, wird also bei dessen Änderung einmal berechnet statt bei
    // jedem Zugriff neu (die Suche ist eine DFS und wird an drei Stellen gebraucht).
    private IReadOnlyList<FieldValue>? _checkout;
    private IReadOnlyList<CheckoutTargets.Target> _checkoutTargets = Array.Empty<CheckoutTargets.Target>();

    // Per Einstellung abschaltbar. Die Route selbst bleibt berechnet (Panel und Banner
    // zeigen sie weiterhin) — nur die Markierung auf der Scheibe entfällt.
    // Settings.Changed ist abonniert, der Schalter wirkt also sofort.
    private IReadOnlyList<CheckoutTargets.Target> VisibleCheckoutTargets
        => Settings.HighlightCheckout ? _checkoutTargets : Array.Empty<CheckoutTargets.Target>();

    // Felder, die im Conquest-Modus einem anderen (noch spielenden) Spieler gehören.
    // Leer, wenn der Modifikator aus ist.
    private IReadOnlySet<BoardPosition> _foreignFields = new HashSet<BoardPosition>();

    private void RecomputeCheckout()
    {
        _checkout = FindCheckout();

        var g = Game.Current;
        if (g is null)
        {
            _checkoutTargets = Array.Empty<CheckoutTargets.Target>();
            _foreignFields = new HashSet<BoardPosition>();
            return;
        }

        _foreignFields = FieldOwnership.ForeignTo(g, g.CurrentPlayerIndex);
        _checkoutTargets = CheckoutTargets.For(
            _checkout, _layout, g.HiddenValues, g.RevealedPositions, UsablePositions(g));
    }

    /// <summary>
    /// Im Conquest-Modus nur die Positionen, aus denen der aktuelle Spieler selbst Punkte
    /// zieht (eigene, gemeinsame, freie) — sonst <c>null</c> für "alle".
    /// </summary>
    private static IReadOnlySet<BoardPosition>? UsablePositions(GameState g)
        => g.Conquest
            ? FieldOwnership.UsableBy(g, g.CurrentPlayerIndex, BoardLayout.AllPositions)
            : null;

    private IReadOnlyList<FieldValue>? FindCheckout()
    {
        var g = Game.Current;
        if (g is null || !g.AcceptsThrows)
            return null;

        var board = _layout ?? BoardLayout.Standard();
        var positions = g.HiddenValues
            ? (IEnumerable<BoardPosition>)g.RevealedPositions
            : BoardLayout.AllPositions;

        // Conquest-Modus: fremde Felder rechnen dem Gegner an, taugen also nicht für den
        // eigenen Checkout — sie fliegen aus Wertevorrat UND Kostenkarte.
        if (UsablePositions(g) is IReadOnlySet<BoardPosition> usable)
            positions = positions.Where(usable.Contains);

        positions = positions.ToList(); // einmal auswerten, wird zweimal gebraucht

        var available = positions.Select(board.ValueAt).Distinct().ToList();
        var dartsLeft = 3 - g.CurrentTurn.Count;

        // Nur im Randomize-Modus nach Treffbarkeit gewichten: dort ist die Wertigkeit von
        // der Position entkoppelt, ein "D8" kann also auf einer breiten Single-Fläche liegen.
        // Auf dem Standardboard bleibt es beim klassischen Vorschlag (höchste Werte zuerst).
        var difficulty = g.Randomize ? FieldDifficulty.Map(board, positions) : null;

        return CheckoutCalculator.Suggest(g.CurrentPlayer.Score, dartsLeft, g.OutMode, available, difficulty);
    }

    // Wer die Ausspiel-Abfrage ausgelöst hat. Im Conquest-Modus muss das nicht der Spieler
    // sein, der geworfen hat (PendingFinisherIndex); ältere Spielstände haben das Feld nicht.
    private static string FinisherName(GameState g)
        => g.PendingFinisherIndex is int index && index >= 0 && index < g.Players.Count
            ? g.Players[index].Name
            : g.CurrentPlayer.Name;

    // Board hit: look up the (shuffled) value for the hit position and reveal it.
    private void HandleBoardHit(BoardPosition pos) => Game.RecordThrow(_layout!.ValueAt(pos), pos);

    // Numpad: a plain dart, no board position to reveal.
    private void HandleDart(FieldValue value) => Game.RecordThrow(value);

    private void Undo() => Game.Undo();

    private void Continue() => Game.ContinuePlaying();

    private void EndAndShowStats() => Game.EndNow(); // OnGameChanged navigates to /stats

    private void ConfirmEnd()
    {
        _confirmEnd = false;
        Game.EndNow(); // OnGameChanged navigates to /stats
    }

    private void ConfirmReveal()
    {
        _confirmReveal = false;
        Game.RevealAll();
    }
}
