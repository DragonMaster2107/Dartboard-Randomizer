@page "/stats"
@inject GameController Game
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    @if (Game.Current is null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">No game to show statistics for.</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Settings" OnClick="NewGame">
            Go to setup
        </MudButton>
    }
    else
    {
        var g = Game.Current;
        var winner = g.Ranking.FirstOrDefault(p => p.HasFinished);

        <MudText Typo="Typo.h4" GutterBottom="true">Game statistics</MudText>

        @if (winner is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" Icon="@Icons.Material.Filled.EmojiEvents">
                <b>@winner.Name</b> wins! 🎯
            </MudAlert>
        }

        <MudStack Row="true" Spacing="2" Class="mb-4" Wrap="Wrap.Wrap">
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Flag">@g.StartingScore</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">@($"{g.OutMode} out")</MudChip>
            @if (g.Randomize)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Shuffle">Randomized</MudChip>
            }
            @if (g.Seed is int seed)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Tag">Seed @seed</MudChip>
            }
        </MudStack>

        @if (g.Players.Any(p => p.ScoreProgression.Count > 1))
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Score progression</MudText>
                <BurndownChart Players="g.Players" StartingScore="g.StartingScore" />
            </MudPaper>
        }

        @* Aufdeck-Anteile — nur im Hidden-Modus sinnvoll (ohne ihn ist alles von Anfang
           an sichtbar). Gleiche Spielerfarben wie im Burndown darüber. *@
        @if (g.HiddenValues)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-2">Fields revealed</MudText>
                <RevealShareChart Players="g.Players" Counts="_revealCounts"
                                  Revealable="RevealStats.Revealable(g)"
                                  UncreditedReveals="RevealStats.UncreditedReveals(g)" />
            </MudPaper>
        }

        <MudTable Items="g.Ranking" Hover="true" Dense="true" Class="mb-4" Elevation="2">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Player</MudTh>
                <MudTh Style="text-align:right">Darts</MudTh>
                <MudTh Style="text-align:right">3-dart avg</MudTh>
                <MudTh Style="text-align:right">Highest turn</MudTh>
                @if (g.HiddenValues)
                {
                    <MudTh Style="text-align:right">Revealed</MudTh>
                }
                <MudTh Style="text-align:right">Left</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#">@(context.FinishRank?.ToString() ?? "–")</MudTd>
                <MudTd DataLabel="Player">@context.Name</MudTd>
                <MudTd DataLabel="Darts" Style="text-align:right">@context.DartsThrown</MudTd>
                <MudTd DataLabel="3-dart avg" Style="text-align:right">@Average(context)</MudTd>
                <MudTd DataLabel="Highest turn" Style="text-align:right">@context.HighestTurn</MudTd>
                @if (g.HiddenValues)
                {
                    <MudTd DataLabel="Revealed" Style="text-align:right">@RevealedBy(context)</MudTd>
                }
                <MudTd DataLabel="Left" Style="text-align:right">@context.Score</MudTd>
            </RowTemplate>
        </MudTable>

        @if (_boardLayout is not null)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Class="mb-3"
                       StartIcon="@Icons.Material.Filled.GridOn" OnClick="@(() => _showBoard = true)">
                Show full board
            </MudButton>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Replay" OnClick="NewGame">
            New game
        </MudButton>

        <MudDialog @bind-Visible="_showBoard" Options="_boardDialogOptions">
            <TitleContent>
                <MudText Typo="Typo.h6">Full board</MudText>
            </TitleContent>
            <DialogContent>
                @* Nur im Conquest-Modus: die Verteilung in Spielerfarben, umschaltbar
                   zwischen Aufdecker und (End-)Besitzer. Das Board selbst ist in jedem
                   Modus vollständig aufgedeckt. *@
                @if (g.Conquest)
                {
                    <MudToggleGroup T="BoardView" @bind-Value="_boardView" Color="Color.Primary"
                                    Size="Size.Small" Class="mb-2">
                        <MudToggleItem Value="BoardView.RevealedBy" Text="Revealed by" />
                        <MudToggleItem Value="BoardView.OwnedBy" Text="Owned by" />
                    </MudToggleGroup>
                    @* Macht den Unterschied zwischen den beiden Ansichten nachvollziehbar:
                       nach einem "Reveal all" erobern Treffer weiter, decken aber nichts
                       mehr auf — dann zeigt "Owned by" mehr Felder als "Revealed by". *@
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                        @BoardCaption(g)
                    </MudText>
                }
                @if (_boardLayout is not null)
                {
                    <DartBoard Layout="_boardLayout" Hidden="false" PlayerFields="HighlightedFields(g)" />
                }
                @if (g.Conquest)
                {
                    <div class="board-legend">
                        @for (var i = 0; i < g.Players.Count; i++)
                        {
                            var color = PlayerPalette.For(i);
                            <span class="legend-item">
                                <span class="swatch" style="background:@color"></span>@g.Players[i].Name
                            </span>
                        }
                    </div>
                }
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _showBoard = false)">Close</MudButton>
            </DialogActions>
        </MudDialog>
    }
</MudContainer>

@code {
    private BoardLayout? _boardLayout;
    private bool _showBoard;
    private readonly DialogOptions _boardDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    /// <summary>Welche Zuordnung das Board im Conquest-Modus einfärbt.</summary>
    private enum BoardView { RevealedBy, OwnedBy }

    private BoardView _boardView = BoardView.RevealedBy;

    // Aufgedeckte Felder pro Spieler — einmal berechnet, von Chart und Tabelle genutzt.
    private IReadOnlyList<int> _revealCounts = Array.Empty<int>();

    protected override void OnInitialized()
    {
        var g = Game.Current;
        if (g is null)
            return;

        // Board rekonstruieren: geshuffelt (per Seed) oder Standard.
        _boardLayout = g is { Randomize: true, Seed: int seed }
            ? BoardLayout.Shuffled(seed)
            : BoardLayout.Standard();

        _revealCounts = RevealStats.CountsByPlayer(g);
    }

    /// <summary>
    /// Die Einfärbung fürs Board. Nur im Conquest-Modus — sonst leer, dann zeigt das Board
    /// wie bisher einfach alle Wertigkeiten.
    /// <para>
    /// „Owned by" nimmt <c>FieldOwners</c> <b>roh</b>, also ohne die Spielregel „Besitz
    /// erlischt beim Auschecken": in der Rückschau interessiert, wer das Feld am Ende
    /// erobert hatte. Mit dem Filter wäre das Board nach einem ausgespielten Spiel leer.
    /// </para>
    /// </summary>
    private IReadOnlyDictionary<BoardPosition, int> HighlightedFields(GameState g)
    {
        if (!g.Conquest)
            return EmptyFields;

        return _boardView == BoardView.OwnedBy ? g.FieldOwners : g.RevealedBy;
    }

    private static readonly IReadOnlyDictionary<BoardPosition, int> EmptyFields =
        new Dictionary<BoardPosition, int>();

    /// <summary>
    /// Beschriftung unter dem Umschalter: wie viele Felder gerade eingefärbt sind — und der
    /// Grund, wenn beide Ansichten unterschiedlich viele zeigen.
    /// </summary>
    private string BoardCaption(GameState g)
    {
        var shown = HighlightedFields(g).Count;
        var what = _boardView == BoardView.OwnedBy ? "conquered" : "revealed";
        var caption = $"{shown} of {RevealStats.Revealable(g)} fields {what} by a player";

        var uncredited = RevealStats.UncreditedReveals(g);
        if (uncredited > 0)
            caption += $" · {uncredited} uncovered with “Reveal” and credited to no one";

        return caption;
    }

    // Die Tabelle läuft über Ranking, die Farben/Zähler hängen am Index in Players.
    // Namen sind im Setup eindeutig (case-insensitive), taugen also als Schlüssel.
    private int RevealedBy(PlayerState player)
    {
        var players = Game.Current!.Players;
        for (var i = 0; i < players.Count; i++)
        {
            if (players[i].Name == player.Name)
                return i < _revealCounts.Count ? _revealCounts[i] : 0;
        }
        return 0;
    }

    // 3-Dart-Average = erzielte Punkte / geworfene Darts * 3.
    private string Average(PlayerState p)
    {
        var scored = Game.Current!.StartingScore - p.Score;
        var avg = p.DartsThrown == 0 ? 0.0 : (double)scored / p.DartsThrown * 3;
        return avg.ToString("F1");
    }

    private void NewGame()
    {
        Game.EndGame();
        Nav.NavigateTo("");
    }
}
