@using System.Globalization
@using Dartboard_Randomizer.Core.Models

@if (_maxIndex >= 1)
{
    <svg viewBox="0 0 400 250" class="burndown" xmlns="http://www.w3.org/2000/svg">
        @* horizontal gridlines + y labels *@
        @for (var t = 0; t <= 4; t++)
        {
            var val = StartingScore * (4 - t) / 4;
            var y = YFor(val);
            <line x1="@F(PlotLeft)" y1="@F(y)" x2="@F(PlotRight)" y2="@F(y)" class="grid" />
            <g><text x="@F(PlotLeft - 4)" y="@F(y)" class="y-label">@val</text></g>
        }

        @* x-axis turn labels *@
        @for (var i = 0; i <= _maxIndex; i++)
        {
            <g><text x="@F(XFor(i))" y="@F(PlotBottom + 12)" class="x-label">@i</text></g>
        }

        @* one line per player *@
        @for (var pi = 0; pi < Players.Count; pi++)
        {
            var color = Palette[pi % Palette.Length];
            <polyline points="@PointsFor(Players[pi])" fill="none" stroke="@color" stroke-width="2" class="line" />
        }
    </svg>

    <div class="legend">
        @for (var pi = 0; pi < Players.Count; pi++)
        {
            var color = Palette[pi % Palette.Length];
            <span class="legend-item">
                <span class="swatch" style="background:@color"></span>@Players[pi].Name
            </span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlayerState> Players { get; set; } = Array.Empty<PlayerState>();
    [Parameter] public int StartingScore { get; set; }

    private static readonly string[] Palette =
        { "#d32f2f", "#1e88e5", "#43a047", "#fbc02d", "#8e24aa", "#00acc1", "#f4511e", "#3949ab" };

    private const double PlotLeft = 34, PlotRight = 392, PlotTop = 10, PlotBottom = 224;

    private int _maxIndex;

    protected override void OnParametersSet()
        => _maxIndex = Players.Count == 0 ? 0 : Players.Max(p => p.ScoreProgression.Count) - 1;

    private double XFor(int i) => _maxIndex == 0 ? PlotLeft : PlotLeft + (PlotRight - PlotLeft) * i / _maxIndex;

    private double YFor(int score) => StartingScore <= 0 ? PlotBottom : PlotBottom - (PlotBottom - PlotTop) * score / StartingScore;

    private string PointsFor(PlayerState p)
    {
        var parts = new string[p.ScoreProgression.Count];
        for (var i = 0; i < p.ScoreProgression.Count; i++)
            parts[i] = $"{F(XFor(i))},{F(YFor(p.ScoreProgression[i]))}";
        return string.Join(' ', parts);
    }

    private static string F(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);
}
