@inherits LayoutComponentBase
@inject GameController Game
@inject GameStorage Storage
@inject AppSettings Settings
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider Theme="AppTheme.Dartboard" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6">Dartboard Randomizer</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit"
                       OnClick="@(() => _settingsOpen = true)" aria-label="Settings" />
    </MudAppBar>
    <MudMainContent Class="app-main">
        @Body
    </MudMainContent>
</MudLayout>

<MudDialog @bind-Visible="_settingsOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />Settings
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudSwitch @bind-Value="SwapColors" Color="Color.Primary"
                   Label="Swap board black/white fields" />
        <MudSwitch @bind-Value="ShowBanner" Color="Color.Primary"
                   Label="Show turn banner (mobile)" />
        <MudSwitch @bind-Value="HighlightCheckout" Color="Color.Primary"
                   Label="Highlight checkout fields on board" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _settingsOpen = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _settingsOpen;
    private IJSObjectReference? _bannerModule;

    private bool SwapColors
    {
        get => Settings.SwapBoardColors;
        set
        {
            Settings.SetSwapBoardColors(value);
            _ = Storage.SaveBoardColorSwapAsync(value);
        }
    }

    private bool ShowBanner
    {
        get => Settings.ShowTurnBanner;
        set
        {
            Settings.SetShowTurnBanner(value);
            _ = Storage.SaveShowTurnBannerAsync(value);
        }
    }

    private bool HighlightCheckout
    {
        get => Settings.HighlightCheckout;
        set
        {
            Settings.SetHighlightCheckout(value);
            _ = Storage.SaveHighlightCheckoutAsync(value);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Laufendes Spiel wiederherstellen
        if (!Game.HasActiveGame)
        {
            var saved = await Storage.LoadAsync();
            if (saved is not null)
                Game.Restore(saved);
        }
        Game.Changed += OnGameChanged;

        // Einstellungen wiederherstellen
        Settings.SetSwapBoardColors(await Storage.LoadBoardColorSwapAsync());
        Settings.SetShowTurnBanner(await Storage.LoadShowTurnBannerAsync());
        Settings.SetHighlightCheckout(await Storage.LoadHighlightCheckoutAsync());

        // Banner beim Pinch-Zoom am sichtbaren oberen Rand halten
        _bannerModule = await JS.InvokeAsync<IJSObjectReference>("import", $"{Nav.BaseUri}js/banner.js");
        await _bannerModule.InvokeVoidAsync("initBannerPin");
    }

    private void OnGameChanged() => _ = PersistAsync();

    private async Task PersistAsync()
    {
        if (Game.Current is null)
            await Storage.ClearAsync();
        else
            await Storage.SaveAsync(Game.Current);
    }

    public void Dispose()
    {
        Game.Changed -= OnGameChanged;
        _ = _bannerModule?.DisposeAsync();
    }
}
